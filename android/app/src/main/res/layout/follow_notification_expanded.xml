<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="14dp"
  android:background="@drawable/follow_notification_surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/follow_train" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:textColor="#FFFFFF"
      android:textSize="18sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/follow_status" android:layout_width="0dp"
      android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end"
      android:layout_marginStart="8dp" android:textColor="#A9DFF2"
      android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginTop="13dp" android:layout_marginBottom="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/follow_origin" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textStyle="bold" android:textSize="14sp"
        android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end"/>
      <TextView android:id="@+id/follow_departure" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textSize="12sp" android:textColor="#B9D0DD"/>
    </LinearLayout>
    <TextView android:layout_width="36dp" android:layout_height="wrap_content"
      android:gravity="center" android:text="→" android:textSize="23sp"
      android:textColor="#64C9FC"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/follow_destination" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="end" android:textStyle="bold"
        android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2"
        android:ellipsize="end"/>
      <TextView android:id="@+id/follow_arrival" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="end" android:layout_marginTop="4dp"
        android:textSize="12sp" android:textColor="#B9D0DD"/>
    </LinearLayout>
  </LinearLayout>
  <ProgressBar android:id="@+id/follow_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent" android:layout_height="6dp"
    android:max="100" android:progress="0" android:progressTint="#49BFFC"
    android:progressBackgroundTint="#4D6170"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginTop="9dp">
    <TextView android:id="@+id/follow_progress_description"
      android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:textColor="#B9D0DD" android:textSize="11sp" android:maxLines="2"/>
    <TextView android:id="@+id/follow_eta"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="5dp" android:textColor="#A9DFF2"
      android:textSize="11sp" android:maxLines="1"/>
  </LinearLayout>
</LinearLayout>