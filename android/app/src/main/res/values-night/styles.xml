<resources>
  <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/brand_red</item>
    <item name="android:statusBarColor">@color/system_surface_dark</item>
    <item name="android:navigationBarColor">@color/navigation_dark</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
  <style name="LauncherTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:statusBarColor">@color/system_surface_dark</item>
    <item name="android:navigationBarColor">@color/navigation_dark</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
</resources>
